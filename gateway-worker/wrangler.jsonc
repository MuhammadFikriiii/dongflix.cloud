{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dongflix-web-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-18",
  "observability": { "enabled": true },
  "ratelimits": [
    {
      "name": "PUBLIC_API_LIMITER",
      "namespace_id": "227722",
      "simple": { "limit": 120, "period": 60 }
    }
  ]
}
